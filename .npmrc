# @langchain/community declares @browserbasehq/stagehand as a peer dependency but
# omits it from peerDependenciesMeta, so npm treats it as required. Stagehand pins
# openai@^4.62.1, which collides with this project's openai@^6, and the install
# fails with ERESOLVE on any clean build (Render, CI, fresh clone).
#
# We do not use stagehand. legacy-peer-deps skips the peer check so it is never
# installed and openai stays on v6.
legacy-peer-deps=true
